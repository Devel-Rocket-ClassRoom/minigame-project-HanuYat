### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Imported
Assets/Imported

# Claude Code local-only settings
.claude/settings.local.json
.claude/worktrees/

# Unity AI Toolkit generated cache
Assets/AI Toolkit/
Assets/AI Toolkit.meta

# AI Toolkit / external generation cache (루트)
/GeneratedAssets/

# === Firebase ===
# 시크릿: google-services.json (API 키 포함) — 팀원/빌드머신에 따로 배포
Assets/StreamingAssets/google-services.json
Assets/StreamingAssets/google-services.json.meta
Assets/StreamingAssets/google-services-desktop.json
Assets/StreamingAssets/google-services-desktop.json.meta

# 시크릿: FirebaseConfig 에셋 (apiKey 입력해둠) — 따로 배포
# (apiKey 비우고 databaseUrl만 남기면 커밋해도 안전 — 코드는 databaseUrl만 읽음)
Assets/Resources/FirebaseConfig.asset
Assets/Resources/FirebaseConfig.asset.meta

# Firebase Unity SDK 바이너리는 커밋함 (Windows 전용 → macOS .bundle / Linux .so / 모바일 제거).
# 100MB 초과 파일 없음 → LFS 불필요.